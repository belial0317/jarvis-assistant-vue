{
  "name": "@jarvis/ai-assistant",
  "version": "0.1.0",
  "description": "框架无关的 Vue 3 AI 助手组件库，支持任意 Vue 3 + ant-design-vue 项目通过 npm/pnpm 引入",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "vue",
    "ai",
    "assistant",
    "chat",
    "mcp",
    "nl2sql",
    "agent",
    "ant-design-vue"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./design-tokens.css": "./dist/styles/design-tokens.css",
    "./utilities.css": "./dist/styles/utilities.css",
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js"
    },
    "./modules/*": {
      "types": "./dist/modules/*/index.d.ts",
      "import": "./dist/modules/*/index.js"
    }
  },
  "sideEffects": [
    "**/*.vue",
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vue-tsc --noEmit && vite build",
    "type-check": "vue-tsc --noEmit",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "@iconify/vue": "^4.1.0 || ^5.0.0",
    "ant-design-vue": "^4.2.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@iconify/vue": "^5.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "ant-design-vue": "^4.2.6",
    "typescript": "^5.5.0",
    "vite": "^5.4.0 || ^8.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vue": "^3.5.40",
    "vue-tsc": "^3.0.0"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
