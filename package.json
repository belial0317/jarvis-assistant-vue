{
  "name": "@jarvis/ai-assistant",
  "version": "0.1.0",
  "description": "框架无关的 Vue 3 AI 助手组件库，支持任意 Vue 3 + ant-design-vue 项目通过 npm/pnpm 引入",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "vue",
    "ai",
    "assistant",
    "chat",
    "mcp",
    "nl2sql",
    "agent",
    "ant-design-vue"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/index.css",
    "./design-tokens.css": "./dist/styles/design-tokens.css",
    "./utilities.css": "./dist/styles/utilities.css"
  },
  "sideEffects": [
    "**/*.vue",
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vue-tsc --noEmit && vite build",
    "type-check": "vue-tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.vue",
    "lint:fix": "eslint . --ext .ts,.vue --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\"",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "peerDependencies": {
    "@iconify/vue": "^4.1.0 || ^5.0.0",
    "ant-design-vue": "^4.2.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.130",
    "@iconify/vue": "^5.0.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "ant-design-vue": "^4.2.6",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.29.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0 || ^8.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4",
    "vue": "^3.5.42",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^3.0.0"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "dependencies": {
    "@vue-flow/core": "^1.48.2",
    "dompurify": "^3.4.15",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.1"
  }
}
